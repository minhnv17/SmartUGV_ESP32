# put here your custom config value
menu "Example Configuration"
config ESP_WIFI_SSID
    string "WiFi SSID"
    default "myssid"
    help
	SSID (network name) for the example to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default "mypassword"
    help
	WiFi password (WPA or WPA2) for the example to use.
endmenu

menu "Robot Display"
config ROBOT_FACE_FLIP_LANDSCAPE
    bool "Flip landscape display 180 degrees"
    default n
    help
        Enable if the face is upside down after mounting the display horizontally.
        Both orientations use a 320x240 layout.
endmenu
